{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/photo",
      "destination": "https://wyqbtcuoorclmirepkuo.supabase.co/functions/v1/resort_photo"
    }
  ],
  "redirects": [
    { "source": "/caribbean/brazil", "destination": "/caribbean", "permanent": true },
    { "source": "/caribbean/brazil/:path*", "destination": "/caribbean", "permanent": true },
    { "source": "/caribbean/ecuador", "destination": "/caribbean", "permanent": true },
    { "source": "/caribbean/ecuador/:path*", "destination": "/caribbean", "permanent": true },
    { "source": "/caribbean/peru", "destination": "/caribbean", "permanent": true },
    { "source": "/caribbean/peru/:path*", "destination": "/caribbean", "permanent": true },
    { "source": "/caribbean/united-states", "destination": "/caribbean", "permanent": true },
    { "source": "/caribbean/united-states/:path*", "destination": "/caribbean", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/resort/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/caribbean/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/from/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/compare/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
